{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "noEmit": true
  },
  "include": [
    "spike/**/*.ts",
    "tests/**/*.ts",
    "src/shared/**/*.ts",
    "src/obs/**/*.ts",
    "src/state/**/*.ts",
    "src/renderer/global.d.ts",
    "src/renderer/**/*.ts"
  ]
}
